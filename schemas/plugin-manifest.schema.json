        },
        "definition": {
          "type": "object",
          "required": [
            "name"
          ],
          "x-parser": "hedit native theme JSON"
        }
      },
      "additionalProperties": false
    },
    "toolProfile": {
      "type": "object",
      "required": [
        "protocol",
        "workspace",
        "arguments"
      ],
      "properties": {
        "protocol": {
          "enum": [
            "filter",
            "language_server"
          ]
        },
        "workspace": {
          "type": "boolean"
        },
        "arguments": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "literal"
                ],
                "properties": {
                  "literal": {
                    "type": "string",
                    "maxLength": 256,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "choice"
                ],
                "properties": {
                  "choice": {
                    "$ref": "#/$defs/id"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "choices": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "$ref": "#/$defs/scalar"
            }
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "protocol": {
                "const": "language_server"
              }
            }
          },
          "then": {
            "properties": {
              "choices": {
                "maxProperties": 0
              },
              "arguments": {
                "items": {
                  "required": [
                    "literal"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "endpoint": {
      "type": "object",
      "required": [
        "url",
        "method",
        "upload",
        "response"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "method": {
          "enum": [
            "GET",
            "POST"
          ]
        },
        "upload": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "response": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "content_type": {
          "enum": [
            "text",
            "json"
          ]
        }
      },
      "additionalProperties": false
    },
    "broker": {
      "type": "object",
      "required": [
        "capabilities"
      ],
      "properties": {
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "enum": [
              "document.read",
              "document.edit",
              "events.observe",
              "ui.present",
              "workspace.discover",
              "workspace.read",
              "workspace.edit",
              "workspace.watch",
              "tools.run",
              "network.https"
            ]
          }
        },
        "tools": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/toolProfile"
          }
        },
        "endpoints": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/endpoint"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "document.edit"
                }
              }
            }
          },
          "then": {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "document.read"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "workspace.edit"
                }
              }
            }
          },
          "then": {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "workspace.read"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "workspace.watch"
                }
              }
            }
          },
          "then": {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "events.observe"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "tools.run"
                }
              }
            }
          },
          "then": {
            "required": [
              "tools"
            ],
            "properties": {
              "tools": {
                "minProperties": 1
              }
            }
          },
          "else": {
            "properties": {
              "tools": {
                "maxProperties": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "network.https"
                }
              }
            }
          },
          "then": {
            "required": [
              "endpoints"
            ],
            "properties": {
              "endpoints": {
                "minProperties": 1
              }
            }
          },
          "else": {
            "properties": {
              "endpoints": {
                "maxProperties": 0
              }
            }
          }
        }
      ]
    }
  }
}
