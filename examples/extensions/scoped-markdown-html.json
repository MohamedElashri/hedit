{
  "api_version": 5,
  "sdk_version": 3,
  "id": "scoped-markdown-html",
  "commands": [
    {
      "id": "convert",
      "title": "Convert selected Markdown through GitHub",
      "action": {
        "kind": "lua",
        "source": "scoped-markdown-html.lua"
      },
      "broker": {
        "capabilities": [
          "document.read",
          "document.edit",
          "network.https"
        ],
        "endpoints": {
          "github-markdown": {
            "url": "https://api.github.com/markdown/raw",
            "method": "POST",
            "upload": 65536,
            "response": 65536,
            "content_type": "text"
          }
        }
      }
    }
  ],
  "script_files": [
    "scoped-markdown-html.lua"
  ]
}
