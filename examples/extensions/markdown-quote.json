{
  "api_version": 2,
  "id": "markdown-quote",
  "permissions": [
    "selection.read",
    "selection.replace"
  ],
  "scripts": {
    "quote.lua": "return function(selection, language)\n  local lines = selection:gsub(\"\\r\\n\", \"\\n\"):gsub(\"\\n\", \"\\n> \")\n  return \"> \" .. lines:gsub(\"\\n> $\", \"\\n\")\nend"
  },
  "commands": [
    {
      "id": "quote",
      "title": "Quote selection as Markdown",
      "when": {
        "selection": true
      },
      "action": {
        "kind": "lua",
        "source": "quote.lua"
      }
    }
  ]
}
